plugin "daisyui/theme" {
  name: " "; /* Custom name is present */
  default: true;        /* Set to true */
  prefersdark: false;
  color-scheme: "light";

  /* 2. Base/Background Colors */
  --color-base-100: oklch(.     );      
  --color-base-200: oklch(.        );       
  --color-base-300: oklch(.         );       
  --color-base-content: oklch(.      );   


  /* 3. Primary & Accent Colors */
  --color-primary: oklch(.      );        
  --color-primary-content: oklch(.       );
  --color-secondary: oklch(.     );
  --color-secondary-content: oklch(.       )
  --color-accent: oklch(   ); 
  --color-accent-content: oklch(.    );

/* 4. Functional UI Feedback Colors */
  --color-info: oklch (.   );
  --color-info-content: oklch(.   );
  --color-success: oklch(.    );      
  --color-success-content: oklch(.  );
  --color-warning: oklch( );
  --color-warning-content: oklch( );
  --color-error: oklch(.    );          
  --color-error-content: oklch(.   );

  /* 5. UI Elements Customization (Optional) */
  --radius-selector: 0.75rem;                 /* Makes checkboxes/radios softer */
  --radius-field: 0.5rem;                     /* Input field roundness */
  --radius-box: 1rem;                         /* Prompt card roundness */
  --border: 1px;
}
